# Copy this file to .env.local and fill in the values. Never commit real credentials.

# ID of the NEW, separate spreadsheet for membership applications (not its full URL).
# From https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit, copy SPREADSHEET_ID.
# Create a "Builders" tab with the headers in docs/community-form.md and share the
# spreadsheet with the Google service account as Editor. Do not use the project
# directory spreadsheet here. Leave blank until ready; submissions will be unavailable.
GOOGLE_COMMUNITY_SHEETS_ID=

# Server-only Google service account JSON, encoded as base64.
# Reuse the existing project integration credential if already configured.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
