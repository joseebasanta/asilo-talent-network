---
import "../styles/fonts.css";
import "../styles/global.css";
import "../styles/motion.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SeoHead from "../components/SeoHead.astro";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  /** Keep the page out of search indexes (e.g. a project that no longer exists). */
  noindex?: boolean;
}

const {
  title = "Asilo Builders",
  description = "La comunidad de builders de Venezuela: developers, diseñadores y emprendedores que construyen con IA juntos.",
  canonical = new URL(Astro.url.pathname, "https://builders.asilodigital.com").toString(),
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#000a11" />
    <SeoHead title={title} description={description} canonical={canonical} noindex={noindex} />
    <link rel="preload" href="/fonts/doto.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-sans.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg?v=20260911" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <SiteHeader />
    <main id="contenido">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import "../scripts/scroll-reveal.js";
    </script>
  </body>
</html>
