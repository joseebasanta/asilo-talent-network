---
import MemberLayout from "../../layouts/MemberLayout.astro";
import { isaacAccountsPrototypeEnabled } from "../../lib/accounts/demo-gate";
const enabled = isaacAccountsPrototypeEnabled();
if (!enabled) Astro.response.status = 404;
---
{enabled ? (
  <MemberLayout title="Onboarding demo | Asilo Builders">
    <section class="wizard account-demo" aria-labelledby="wizard-title" data-demo-onboarding>
      <div class="wizard-inner">
        <div class="demo-gate" data-demo-gate>
          <p class="demo-eyebrow">Onboarding · simulación local</p>
          <h1 class="wizard-title">Entra al demo para continuar</h1>
          <p class="wizard-lead">Esta pantalla no es autenticación ni seguridad. Solo muestra el flujo original con una identidad sintética.</p>
          <div class="demo-actions"><a class="button button-primary" href="/demo-cuentas/entrar">Entrar al demo</a><a class="button button-secondary" href="/demo-cuentas">Volver</a></div>
        </div>
        <div data-demo-flow hidden>
          <p class="demo-eyebrow">Onboarding · experiencia sintética · No es autenticación real</p>
          <div class="demo-flow-head"><span>Sesión sintética activa solo en esta pestaña.</span><button class="link-button" type="button" data-demo-sign-out>Salir del demo</button></div>
          <ol class="stepper" aria-label="Pasos del registro del proyecto" data-stepper hidden>
            <li data-s="info"><span>1</span> Información</li><li data-s="details"><span>2</span> Detalles</li><li data-s="founders"><span>3</span> Fundadores</li><li data-s="review"><span>4</span> Revisión</li>
          </ol>
          <form class="step" data-step="profile" novalidate>
            <h1 id="wizard-title" class="wizard-title">Cuéntanos quién eres</h1>
            <p class="wizard-lead">Completa tu perfil de muestra. Nada se envía ni se guarda al salir.</p>
            <div class="form-grid"><label class="field" data-field="name"><span class="field-label">Nombre de muestra</span><input class="field-input" name="name" value="Lucía Demo" maxlength="150" /></label><label class="field" data-field="role"><span class="field-label">Rol</span><select class="field-input" name="role"><option value="founder">Founder</option><option value="cofounder">Cofounder</option><option value="developer">Developer</option><option value="diseno">Diseño</option></select></label><label class="field" data-field="city"><span class="field-label">Ciudad</span><input class="field-input" name="city" value="Caracas" maxlength="100" /></label><label class="field" data-field="country"><span class="field-label">País</span><input class="field-input" name="country" value="Venezuela" maxlength="100" /></label></div>
            <label class="field" data-field="bio"><span class="field-label">Bio corta (opcional)</span><textarea class="field-input field-area" name="bio" rows="3" maxlength="280" placeholder="¿Qué construyes?"></textarea></label>
            <fieldset class="field radio-group"><legend class="field-label">¿Ya estás en el grupo de WhatsApp?</legend><label class="radio"><input type="radio" name="inWhatsappGroup" value="yes" /> Sí</label><label class="radio"><input type="radio" name="inWhatsappGroup" value="no" checked /> Aún no</label></fieldset>
            <p class="field-error form-error" data-form-error role="alert" hidden></p><div class="step-actions"><button class="button button-primary" type="submit">Continuar</button></div>
          </form>
          <section class="step" data-step="ask" hidden><h1 class="wizard-title">¿Tienes un proyecto?</h1><p class="wizard-lead">Puedes registrarlo ahora o explorar el demo como miembro de la comunidad.</p><div class="ask-options"><button class="ask-option" type="button" data-ask="yes"><strong>Sí, registrarlo</strong><span>Te guiamos por el flujo completo.</span></button><button class="ask-option" type="button" data-ask="no"><strong>Aún no</strong><span>Termina el onboarding sin crear un proyecto.</span></button></div></section>
          <form class="step" data-step="info" novalidate hidden><h1 class="wizard-title">Información del proyecto</h1><label class="field" data-field="website"><span class="field-label">Web o enlace principal</span><span class="input-with-button"><input class="field-input" name="website" inputmode="url" placeholder="tuproyecto.com" maxlength="500" /><button class="button button-secondary autofill" type="button" data-autofill>Autocompletar</button></span><span class="field-hint">Autocompletado simulado: no se hacen solicitudes externas.</span><p class="field-error" data-error hidden></p></label><p class="field-hint warn" data-autofill-note role="status" hidden></p><label class="field" data-field="name"><span class="field-label">Nombre del proyecto</span><input class="field-input" name="name" maxlength="120" /><p class="field-error" data-error hidden></p></label><label class="field" data-field="short"><span class="field-label">Descripción corta</span><input class="field-input" name="short" maxlength="140" placeholder="Una frase que explique qué haces" /><p class="field-error" data-error hidden></p></label><label class="field"><span class="field-label">Descripción larga (opcional)</span><textarea class="field-input field-area" name="long" rows="4" maxlength="3000"></textarea></label><div class="field" data-field="logo"><span class="field-label">Logo sintético (PNG, JPG o WebP, máx. 1 MB)</span><label class="logo-upload logo-upload--wizard"><span class="logo-preview" data-logo-preview aria-hidden="true">+</span><span class="logo-upload-text" data-logo-text>Sube un logo de prueba</span><input class="logo-upload-input" type="file" name="logo" accept="image/png,image/jpeg,image/webp" /></label><p class="field-error" data-error hidden></p></div><p class="field-error form-error" data-form-error role="alert" hidden></p><div class="step-actions"><button class="button button-secondary" type="button" data-back>Anterior</button><button class="button button-primary" type="submit">Siguiente</button></div></form>
          <form class="step" data-step="details" novalidate hidden><h1 class="wizard-title">Detalles</h1><div class="form-grid"><label class="field" data-field="sector"><span class="field-label">Sector</span><select class="field-input" name="sector"><option value="">Elige el sector</option><option>Fintech</option><option>Educación</option><option>Salud</option><option>SaaS</option><option>Social &amp; Comunidad</option><option>Otro</option></select><p class="field-error" data-error hidden></p></label><label class="field" data-field="stage"><span class="field-label">Etapa</span><select class="field-input" name="stage"><option value="">Elige la etapa</option><option>Idea</option><option>MVP</option><option>Primeros clientes</option><option>Crecimiento</option><option>Consolidado</option></select><p class="field-error" data-error hidden></p></label></div><label class="check"><input type="checkbox" name="seekingInvestment" /> Estamos buscando inversión</label><label class="field"><span class="field-label">Ciudad base (opcional)</span><input class="field-input" name="city" maxlength="100" /></label><fieldset class="field socials"><legend class="field-label">Redes sociales (opcional)</legend><div class="form-grid"><input class="field-input" name="instagram" placeholder="Instagram" aria-label="Instagram" /><input class="field-input" name="tiktok" placeholder="TikTok" aria-label="TikTok" /><input class="field-input" name="x" placeholder="X" aria-label="X" /><input class="field-input" name="linkedin" placeholder="LinkedIn" aria-label="LinkedIn" /></div></fieldset><p class="field-error form-error" data-form-error role="alert" hidden></p><div class="step-actions"><button class="button button-secondary" type="button" data-back>Anterior</button><button class="button button-primary" type="submit">Siguiente</button></div></form>
          <form class="step" data-step="founders" novalidate hidden><h1 class="wizard-title">Fundadores</h1><p class="wizard-lead">Tú apareces como fundador. Las invitaciones son simuladas y no se envían.</p><label class="field"><span class="field-label">Tu rol en el proyecto</span><select class="field-input" name="myRole"><option value="founder">Founder</option><option value="cofounder">Cofounder</option><option value="equipo">Equipo</option></select></label><ul class="founder-list" data-founder-list></ul><div class="invite-row"><label class="field"><span class="field-label">Invitar a una persona (simulado)</span><input class="field-input" name="inviteAddress" type="text" placeholder="persona de prueba" maxlength="120" /></label><label class="field"><span class="field-label">Rol</span><select class="field-input" name="inviteRole"><option value="cofounder">Cofounder</option><option value="equipo">Equipo</option></select></label><button class="button button-secondary" type="button" data-invite>Agregar</button></div><p class="field-error" data-invite-error hidden></p><p class="field-error form-error" data-form-error role="alert" hidden></p><div class="step-actions"><button class="button button-secondary" type="button" data-back>Anterior</button><button class="button button-primary" type="submit">Siguiente</button></div></form>
          <section class="step" data-step="review" hidden><h1 class="wizard-title">Revisión y publicación</h1><p class="wizard-lead">Así se vería tu proyecto en el directorio. Puedes volver y editar cualquier campo.</p><div data-review></div><p class="field-error form-error" data-form-error role="alert" hidden></p><div class="step-actions"><button class="button button-secondary" type="button" data-back>Anterior</button><button class="button button-secondary" type="button" data-edit>Editar</button><button class="button button-secondary" type="button" data-save="draft">Guardar borrador</button><button class="button button-primary" type="button" data-save="published">Publicar demo</button></div></section>
          <section class="step" data-step="done" hidden><h1 class="wizard-title" data-done-title>¡Listo!</h1><p class="wizard-lead" data-done-lead></p><div data-done-card></div><div class="demo-notice" role="status">Resultado simulado: no se creó una cuenta, no se enviaron invitaciones y no se escribió en ningún servicio.</div><div class="step-actions"><a class="button button-primary" href="/demo-cuentas">Volver al demo</a><button class="button button-secondary" type="button" data-another>Agregar otro proyecto</button></div></section>
          <section class="step" data-step="member" hidden><h1 class="wizard-title">Ya eres parte de la comunidad</h1><p class="wizard-lead">Puedes volver al demo cuando tengas un proyecto de prueba.</p><div class="step-actions"><a class="button button-primary" href="/demo-cuentas">Volver al demo</a></div></section>
        </div>
      </div>
    </section>
    <script>import "../../scripts/onboarding.ts";</script>
  </MemberLayout>
) : (
  <html lang="es"><head><meta charset="utf-8" /><meta name="robots" content="noindex, nofollow" /><title>Página no encontrada</title></head><body><main><h1>Página no encontrada</h1></main></body></html>
)}
