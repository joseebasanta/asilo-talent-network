---
import MemberLayout from "../../layouts/MemberLayout.astro";
import { isaacAccountsPrototypeEnabled } from "../../lib/accounts/demo-gate";
const enabled = isaacAccountsPrototypeEnabled();
if (!enabled) Astro.response.status = 404;
---
{enabled ? <MemberLayout title="Anuncios demo | Asilo Builders" description="Feed sintético del prototipo de anuncios."><section class="panel account-demo account-demo-panel" data-demo-feed aria-labelledby="demo-feed-title"><div class="panel-inner narrow"><div data-demo-gate class="demo-gate"><p class="demo-eyebrow">Anuncios · prototipo local</p><h1 class="wizard-title">Explora los anuncios de la comunidad</h1><p class="wizard-lead">Esta sesión usa publicaciones sintéticas. No es una cuenta real ni guarda actividad fuera de memoria.</p><a class="button button-primary" href="/demo-cuentas/entrar">Entrar sin credenciales</a></div><div data-demo-body hidden><header class="panel-head"><div><p class="demo-eyebrow">Comunidad · simulación</p><h1 id="demo-feed-title" class="wizard-title">Anuncios</h1></div><a class="button button-secondary" href="/demo-cuentas/anuncios/promociones">Promocionar un proyecto</a></header><form class="composer composer--social" data-composer><label class="sr-only" for="demo-composer-text">¿Qué quieres contar?</label><textarea class="composer-text" id="demo-composer-text" name="text" rows="2" maxlength="1000" placeholder="¿Qué quieres contar?" required></textarea><p class="composer-hint">Publicar está simulado y no llega a ninguna API.</p><div class="composer-tools"><label class="project-pill">Proyecto relacionado <select name="project" data-demo-project></select></label><label class="icon-button"><span class="sr-only">Añadir imagen</span><input type="file" name="image" accept="image/png,image/jpeg,image/webp" /></label></div><div data-demo-image-preview class="composer-image"></div><div data-demo-link-preview></div><div class="composer-bar"><span class="field-hint">Datos sintéticos</span><button class="send-button" type="submit">Publicar en demo</button></div></form><div class="feed-list" data-demo-list aria-live="polite"></div><div class="toast" data-demo-toast role="status" hidden></div></div></div></section><script>import "../../scripts/demo-feed.ts";</script></MemberLayout> : <html lang="es"><head><meta charset="utf-8" /><title>Página no encontrada</title></head><body><main><h1>Página no encontrada</h1></main></body></html>}
