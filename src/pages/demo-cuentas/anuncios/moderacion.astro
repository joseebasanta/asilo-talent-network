---
import MemberLayout from "../../../layouts/MemberLayout.astro";
import { isaacAccountsPrototypeEnabled } from "../../../lib/accounts/demo-gate";
const enabled = isaacAccountsPrototypeEnabled();
if (!enabled) Astro.response.status = 404;
---
{enabled ? <MemberLayout title="Moderación demo | Asilo Builders"><section class="panel account-demo account-demo-panel" data-demo-moderation><div class="panel-inner narrow"><div class="demo-gate" data-demo-gate><p class="demo-eyebrow">Moderación · demo</p><h1 class="wizard-title">Entra al demo para continuar</h1><p class="wizard-lead">Esta vista es una simulación local y no representa permisos reales.</p><a class="button button-primary" href="/demo-cuentas/entrar">Entrar sin credenciales</a></div><div data-demo-moderation-body hidden><p class="demo-eyebrow">Equipo de Asilo · simulación</p><h1 class="wizard-title">Moderación de anuncios</h1><p class="mock-note" role="note">Las acciones solo cambian esta vista en memoria. No representan permisos reales.</p><div class="report-list"><div class="report" data-demo-report><strong>Reporte sintético · Pana Pay</strong><p class="field-hint">Contenido de ejemplo reportado por una persona ficticia.</p><div class="row-actions"><button class="button button-primary" type="button" data-demo-resolve>Ocultar en demo</button><button class="button button-secondary" type="button" data-demo-resolve>Descartar reporte</button></div></div></div></div></div></section><script>import "../../../scripts/demo-feed.ts";</script></MemberLayout> : <html lang="es"><head><meta charset="utf-8" /><title>Página no encontrada</title></head><body><main><h1>Página no encontrada</h1></main></body></html>}
