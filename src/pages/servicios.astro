---
// Landing de servicios v2. Se construye sección por sección desde Figma:
// cada sección nueva es un componente en src/components/servicios/ montado dentro de <main>.
import "../styles/fonts.css";
import "../styles/servicios.css";
import SeoHead from "../components/SeoHead.astro";
import Nav from "../components/servicios/Nav.astro";
import Hero from "../components/servicios/Hero.astro";
import Projects from "../components/servicios/Projects.astro";
import { seo } from "../data/servicios";

export const prerender = true;

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://builders.asilodigital.com";
const canonical = `${siteUrl}/servicios`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0f0f0f" />
    <SeoHead
      title={seo.title}
      description={seo.description}
      canonical={canonical}
      image={`${siteUrl}/og-servicios.png`}
      siteName="Asilo Digital"
    />
    <link rel="icon" href="/favicon.svg?v=20260911" type="image/svg+xml" />
    <link rel="preload" href="/fonts/geist-sans.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-mono.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="servicios">
    <a class="s-skip" href="#contenido">Saltar al contenido</a>
    <Nav />
    <main id="contenido">
      <Hero />
      <Projects />
    </main>
  </body>
</html>
