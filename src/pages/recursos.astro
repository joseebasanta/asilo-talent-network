---
import "../styles/fonts.css";
import "../styles/global.css";
import "../styles/motion.css";
import "../styles/recursos.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SeoHead from "../components/SeoHead.astro";
import { resourceCategories } from "../data/resources";

export const prerender = true;

const totalResources = resourceCategories.reduce((sum, category) => sum + category.resources.length, 0);

// Tag filters present in the data, in a stable order.
const TAG_ORDER = ["free", "freemium", "paid", "open-source"] as const;
const TAG_LABELS: Record<string, string> = {
  free: "Free",
  freemium: "Freemium",
  paid: "Paid",
  "open-source": "Open source",
};
const usedTags = TAG_ORDER.filter((tag) =>
  resourceCategories.some((category) => category.resources.some((resource) => resource.tag === tag)),
);

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://builders.asilodigital.com";
const canonical = `${siteUrl}/recursos`;
const pageTitle = "Recursos | Asilo Builders";
const pageDescription =
  "Biblioteca curada de recursos de diseño de producto, UI/UX y web para builders de Venezuela: galerías, tipografía, color, íconos, design systems y más.";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#000a11" />
    <SeoHead title={pageTitle} description={pageDescription} canonical={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/doto.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-sans.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="resources-page">
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <SiteHeader />
    <main id="contenido" class="library">
      <section class="library-intro" aria-labelledby="page-title">
        <a class="back-link" href="/">← Volver al inicio</a>
        <h1 id="page-title" data-decode>Recursos</h1>
        <p class="library-description">
          Una biblioteca curada de herramientas y referencias de diseño de producto,
          UI/UX y web. Explora por categoría, busca por nombre o filtra por tipo.
        </p>
      </section>

      <section class="library-body" aria-label="Biblioteca de recursos">
        <form class="library-controls" role="search" id="resource-filters" action="/recursos" method="get" onsubmit="return false">
          <div class="library-search">
            <label class="sr-only" for="resource-query">Buscar recursos</label>
            <div class="search-field">
              <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h10v2H4zM2 6h2v8H2zM4 14h10v2H4zM14 6h2v8h-2zM16 16h3v3h-3zM19 19h3v3h-3z" fill="currentColor" /></svg>
              <input id="resource-query" type="search" name="q" placeholder="Busca una herramienta, recurso o idea…" autocomplete="off" />
            </div>
          </div>
          <div class="tag-filter" role="group" aria-label="Filtrar por tipo">
            <button type="button" class="tag-chip is-active" data-tag="all" aria-pressed="true">Todos</button>
            {usedTags.map((tag) => (
              <button type="button" class="tag-chip" data-tag={tag} aria-pressed="false">{TAG_LABELS[tag]}</button>
            ))}
          </div>
        </form>

        <p class="library-count" id="resource-count" role="status" aria-live="polite" aria-atomic="true">
          {totalResources} recursos en {resourceCategories.length} categorías
        </p>

        <div class="library-layout">
          <aside class="library-nav" aria-label="Categorías">
            <nav>
              <ul>
                {resourceCategories.map((category) => (
                  <li>
                    <a href={`#${category.id}`} data-nav-for={category.id}>
                      <span>{category.title}</span>
                      <small>{category.resources.length}</small>
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>

          <div class="library-sections" id="resource-sections">
            {resourceCategories.map((category) => (
              <section class="library-category" id={category.id} data-category={category.id} aria-labelledby={`${category.id}-title`}>
                <header class="library-category-head">
                  <h2 id={`${category.id}-title`}>{category.title}</h2>
                  {category.desc && <p>{category.desc}</p>}
                </header>
                <ul class="resource-list">
                  {category.resources.map((resource) => (
                    <li
                      class="resource"
                      data-name={resource.name}
                      data-desc={resource.desc}
                      data-tag={resource.tag}
                    >
                      <a class="resource-link" href={resource.url} target="_blank" rel="noopener noreferrer">
                        <span class="resource-main">
                          <span class="resource-name">
                            {resource.name}
                            <svg class="resource-ext" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M9 5h10v10h-3V9.4l-8.3 8.3-2.1-2.1L13.6 7H9V5z" /></svg>
                          </span>
                          {resource.desc && <span class="resource-desc">{resource.desc}</span>}
                        </span>
                        {resource.tag && <span class={`resource-tag tag-${resource.tag}`}>{TAG_LABELS[resource.tag] ?? resource.tag}</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        </div>

        <div class="library-empty" id="resource-empty" hidden>
          <span class="empty-symbol" aria-hidden="true">[ ? ]</span>
          <h2>No encontramos recursos</h2>
          <p>Prueba con otra palabra o cambia el filtro de tipo.</p>
        </div>
      </section>
    </main>
    <SiteFooter />
    <script src="../scripts/resources-explorer.ts"></script>
  </body>
</html>
