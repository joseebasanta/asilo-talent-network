---
import "../styles/fonts.css";
import "../styles/global.css";
import "../styles/motion.css";
import "../styles/projects.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SeoHead from "../components/SeoHead.astro";
import ThemeInit from "../components/ThemeInit.astro";
import ProjectDirectory from "../components/ProjectDirectory.astro";
import { loadApprovedProjects } from "../lib/projects-loader";
import ProjectCard from "../components/ProjectCard.astro";
import { filterProjects, normalizeSearch, limitProjects, parseProjectOrder, showMoreUrl, PROJECTS_PAGE_SIZE } from "../lib/project-search";

const projects = (await loadApprovedProjects()).map((project, index) => ({ ...project, index }));
const categories = Array.from(new Map(projects.flatMap(project => project.tags)
  .map(tag => [normalizeSearch(tag), tag])).values()).sort((a, b) => a.localeCompare(b, "es", { sensitivity: "base" }));
const query = Astro.url.searchParams.get("q") ?? "";
const selected = categories.filter(category => Astro.url.searchParams.getAll("categoria").some(value => normalizeSearch(value) === normalizeSearch(category)));
const order = parseProjectOrder(Astro.url.searchParams.get("orden"));
const ORDER_TABS = [
  { value: "recientes", label: "Últimos añadidos" },
  { value: "visitas", label: "Más visitados" },
  { value: "trending", label: "Trending" },
  { value: "az", label: "A–Z" },
] as const;
const categoryCount = (category: string) => projects.filter(project => project.tags.some(tag => normalizeSearch(tag) === normalizeSearch(category))).length;
const matches = filterProjects(projects, query, selected, order);
const visible = limitProjects(matches, Number(Astro.url.searchParams.get("mostrar") ?? PROJECTS_PAGE_SIZE));
const positions = new Map(visible.items.map((project, index) => [project.index, index]));
const active = Boolean(query || selected.length);
const clearHref = query ? `/proyectos?q=${encodeURIComponent(query)}` : "/proyectos";

export const prerender = false;
Astro.response.headers.set("Cache-Control", "no-store");

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://builders.asilodigital.com";
const canonical = `${siteUrl}/proyectos`;
const pageTitle = "Directorio de proyectos y startups de Venezuela | Asilo Builders";
const pageDescription =
  "Explora los proyectos de Asilo Builders. Descubre productos creados por builders de Venezuela y busca por nombre, fundador o categoría.";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: pageTitle,
  description: pageDescription,
  url: canonical,
  inLanguage: "es",
  isPartOf: { "@type": "WebSite", name: "Asilo Builders", url: siteUrl },
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: projects.length,
    itemListElement: projects
      .filter(project => /^https?:\/\//.test(project.href))
      .map((project, position) => ({ "@type": "ListItem", position: position + 1, name: project.title, url: project.href })),
  },
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#0f1011" />
    <ThemeInit />
    <SeoHead title={pageTitle} description={pageDescription} canonical={canonical} jsonLd={jsonLd} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="projects-page">
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <SiteHeader />
    <main id="contenido" class="explore">
      <section class="explore-hero" aria-labelledby="page-title">
        <h1 id="page-title"><span>Directorio de proyectos y startups</span> <strong>Venezuela</strong></h1>
        <p class="explore-intro">Explora entre proyectos tecnológicos, startups y productos creados por builders venezolanos.</p>
      </section>
      <form class="explore-form" action="/proyectos" method="get" role="search" id="project-filters">
        <div class="search-control">
          <label class="filter-label" for="project-query">Buscar entre {projects.length} {projects.length === 1 ? "proyecto" : "proyectos"}</label>
          <div class="search-field">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="M16 16l5 5" /></svg>
            <input id="project-query" type="search" name="q" value={query} placeholder="Busca un proyecto, fundador o idea…" autocomplete="off" />
            <button type="submit" class="search-submit">Buscar</button>
          </div>
        </div>
        <noscript><p class="no-script-hint">Selecciona tus filtros y pulsa Buscar para ver los resultados.</p></noscript>
        <div class="explore-layout">
          <section class="explore-main" aria-label="Directorio de proyectos">
            <div class="results-toolbar">
              <fieldset class="order-tabs">
                <legend class="sr-only">Ordenar proyectos</legend>
                {ORDER_TABS.map(tab => (
                  <label class="order-tab">
                    <input type="radio" name="orden" value={tab.value} checked={order === tab.value} />
                    <span>{tab.label}</span>
                  </label>
                ))}
              </fieldset>
              <div class="results-meta">
                <p id="project-count" role="status" aria-live="polite" aria-atomic="true">{matches.length} {matches.length === 1 ? "proyecto" : "proyectos"}{active ? ` de ${projects.length}` : " para descubrir"}</p>
                <a href="/proyectos" class="clear-filters" data-clear-filters hidden={!active}>Limpiar filtros <span aria-hidden="true">×</span></a>
              </div>
            </div>
            <div class="explore-grid" id="project-results" tabindex="-1" aria-label="Resultados de proyectos">
              {[...visible.items, ...projects.filter(project => !positions.has(project.index))].map(project => (
                <ProjectCard project={project}
                  data-project-index={project.index} data-title={project.title}
                  data-description={project.description} data-author={project.author}
                  data-tags={JSON.stringify(project.tags)} data-added={project.addedAt}
                  data-visits={project.visits} data-trending={project.trending}
                  hidden={!positions.has(project.index)}
                  style={`order: ${positions.get(project.index) ?? 0}`}
                />
              ))}
            </div>
            <div class="show-more" hidden={!visible.hasMore}>
              <p class="show-more-status" data-show-status role="status" aria-live="polite" aria-atomic="true">Mostrando {visible.shown} de {matches.length} proyectos</p>
              <a class="prj-cta show-more-button" data-show-more href={showMoreUrl(Astro.url, visible.limit + PROJECTS_PAGE_SIZE)}>Ver más</a>
            </div>
            <div class="empty-results" id="empty-results" hidden={matches.length > 0}>
              <span class="empty-symbol" aria-hidden="true">[ ? ]</span>
              <h2>{projects.length ? "No encontramos proyectos" : "Las próximas ideas empiezan aquí"}</h2>
              <p>{projects.length ? "Prueba con otra palabra o cambia las categorías seleccionadas." : "Sé parte del directorio. Comparte lo que estás construyendo con la comunidad."}</p>
              {projects.length > 0 && <a href="/proyectos" class="prj-cta" data-clear-filters>Ver todos los proyectos</a>}
            </div>
          </section>
          <aside class="explore-aside" aria-labelledby="categories-title">
            <h2 class="aside-title" id="categories-title">Categorías</h2>
            <a class="category-all" href={clearHref} data-all-categories aria-current={selected.length ? undefined : "true"}>
              <span>Todas</span><small>{projects.length}</small>
            </a>
            <div class="category-scroll">
            <fieldset class="category-list">
              <legend class="sr-only">Selecciona una o varias categorías</legend>
              {categories.map(category => (
                <label class="cat-row category-option" data-category-name={category}>
                  <input class="cat-checkbox" type="checkbox" name="categoria" value={category} checked={selected.includes(category)} />
                  <span class="cat-box" aria-hidden="true"><svg class="cat-check" viewBox="0 0 12 10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 5l3.5 3.5L11 1" /></svg></span>
                  <span class="cat-name">{category}</span>
                  <small class="category-project-count">{categoryCount(category)}</small>
                </label>
              ))}
            </fieldset>
            </div>
            <div class="aside-cta">
              <p>¿Estás construyendo algo?</p>
              <button class="prj-cta" type="button" data-open-modal>AGREGA TU PROYECTO</button>
            </div>
          </aside>
        </div>
      </form>
    </main>
    <SiteFooter />
    <ProjectDirectory projects={[]} modalOnly />
    <script src="../scripts/project-explorer.ts"></script>
  </body>
</html>
