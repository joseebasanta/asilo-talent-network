---
/**
 * Project detail page: the home for edit requests.
 * Only the trailing id in the slug resolves the project (see
 * project-identity.ts); any other spelling 301s to the canonical slug.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectFormModal from "../../components/ProjectFormModal.astro";
import { findProject } from "../../lib/directory";
import { idFromSlug } from "../../lib/project-identity";
import { projectIconUrl } from "../../lib/project-icons";

const slug = Astro.params.slug ?? "";
const id = idFromSlug(slug);
const project = id ? await findProject(id) : null;

if (project?.slug && project.slug !== slug) {
  return Astro.redirect(`/proyectos/${project.slug}`, 301);
}
if (!project) Astro.response.status = 404;

const host = project ? new URL(project.href).hostname.replace(/^www\./, "") : "";
---

<BaseLayout
  noindex={!project}
  title={project ? `${project.title} · Asilo Builders` : "Proyecto no encontrado · Asilo Builders"}
  description={project?.description}
  canonical={project ? new URL(`/proyectos/${project.slug}`, Astro.url).href : undefined}
>
  <section class="pd" aria-labelledby="pd-title">
    <div class="pd-inner">
      <a class="pd-back" href="/#proyectos">
        <svg class="pd-back-icon" viewBox="10 6 28 36" fill="currentColor" aria-hidden="true"><path d="M16 26V22H20V26H16ZM20 22V18H24V22H20ZM20 30V26H24V30H20ZM24 18V14H28V18H24ZM24 34V30H28V34H24ZM28 14V10H32V14H28ZM28 38V34H32V38H28Z" /></svg>
        Todos los proyectos
      </a>

      {!project && (
        <div class="pd-empty">
          <h1 id="pd-title" class="pd-title">Proyecto no encontrado</h1>
          <p class="pd-desc">Puede que aún esté en revisión o que el enlace haya cambiado.</p>
        </div>
      )}

      {project && (
        <>
          <header class="pd-head">
            <div class="pd-thumb" aria-hidden="true">
              {project.logoUrl ? (
                <img class="prj-logo" src={project.logoUrl} alt="" />
              ) : (
                <img class="prj-placeholder" src={project.iconUrl ?? projectIconUrl(project.tags)} alt="" />
              )}
            </div>
            <div class="pd-titles">
              <h1 id="pd-title" class="pd-title" data-decode>{project.title}</h1>
              {project.author && <p class="pd-author">Por {project.author}</p>}
            </div>
          </header>

          <p class="pd-desc">{project.description}</p>
          {project.tags.length > 0 && (
            <div class="prj-tags pd-tags">
              {project.tags.map((tag) => <span class="prj-tag">{tag}</span>)}
            </div>
          )}

          <div class="pd-actions">
            <a class="button button-primary" href={project.href} target="_blank" rel="noopener noreferrer">
              Visitar {host}
              <svg class="pixel-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M11.3333 14H3.33333V12.6667H11.3333V14ZM3.33333 12.6667H2V4.66667H3.33333V12.6667ZM12.6667 12.6667H11.3333V8.66667H12.6667V12.6667ZM7.33333 10H6V8.66667H7.33333V10ZM8.66667 8.66667H7.33333V7.33333H8.66667V8.66667ZM10 7.33333H8.66667V6H10V7.33333ZM14 7.33333H12.6667V4.66667H11.3333V3.33333H8.66667V2H14V7.33333ZM11.3333 6H10V4.66667H11.3333V6ZM7.33333 4.66667H3.33333V3.33333H7.33333V4.66667Z" /></svg>
            </a>
          </div>

          <p class="pd-owner">
            ¿Es tu proyecto?{" "}
            <button class="pd-owner-link" type="button" data-open-modal>Solicita cambios</button>{" "}
            (logo, descripción, fundadores o categorías).
          </p>
        </>
      )}
    </div>
  </section>

  {project && <ProjectFormModal mode="edit" project={project} />}
</BaseLayout>
