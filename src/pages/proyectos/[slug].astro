---
/**
 * Project detail page: the home for likes, comments and edit requests.
 * Only the trailing id in the slug resolves the project (see
 * project-identity.ts); any other spelling 301s to the canonical slug.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import LikeButton from "../../components/LikeButton.astro";
import ProjectFormModal from "../../components/ProjectFormModal.astro";
import { engagementEnabled, loadProjectPage } from "../../lib/directory";
import { COMMENT_AUTHOR_MAX, COMMENT_BODY_MAX } from "../../lib/engagement/comments";
import { idFromSlug } from "../../lib/project-identity";
import { projectIconUrl } from "../../lib/project-icons";

const slug = Astro.params.slug ?? "";
const id = idFromSlug(slug);
const page = id ? await loadProjectPage(id) : null;
const project = page?.project ?? null;
const comments = page?.comments ?? [];
const engagement = engagementEnabled();

if (project?.slug && project.slug !== slug) {
  return Astro.redirect(`/proyectos/${project.slug}`, 301);
}
if (!project) Astro.response.status = 404;

const dateFormat = new Intl.DateTimeFormat("es-VE", { dateStyle: "medium" });
const host = project ? new URL(project.href).hostname.replace(/^www\./, "") : "";
const TURNSTILE_SITE_KEY = import.meta.env.TURNSTILE_SITE_KEY;
---

<BaseLayout
  noindex={!project}
  title={project ? `${project.title} · Asilo Builders` : "Proyecto no encontrado · Asilo Builders"}
  description={project?.description}
  canonical={project ? new URL(`/proyectos/${project.slug}`, Astro.url).href : undefined}
>
  <section class="pd" aria-labelledby="pd-title">
    <div class="pd-inner">
      <a class="pd-back" href="/#proyectos">
        <svg class="pd-back-icon" viewBox="10 6 28 36" fill="currentColor" aria-hidden="true"><path d="M16 26V22H20V26H16ZM20 22V18H24V22H20ZM20 30V26H24V30H20ZM24 18V14H28V18H24ZM24 34V30H28V34H24ZM28 14V10H32V14H28ZM28 38V34H32V38H28Z" /></svg>
        Todos los proyectos
      </a>

      {!project && (
        <div class="pd-empty">
          <h1 id="pd-title" class="pd-title">Proyecto no encontrado</h1>
          <p class="pd-desc">Puede que aún esté en revisión o que el enlace haya cambiado.</p>
        </div>
      )}

      {project && (
        <>
          <header class="pd-head">
            <div class="pd-thumb" aria-hidden="true">
              {project.logoUrl ? (
                <img class="prj-logo" src={project.logoUrl} alt="" />
              ) : (
                <img class="prj-placeholder" src={project.iconUrl ?? projectIconUrl(project.tags)} alt="" />
              )}
            </div>
            <div class="pd-titles">
              <h1 id="pd-title" class="pd-title" data-decode>{project.title}</h1>
              {project.author && <p class="pd-author">Por {project.author}</p>}
            </div>
          </header>

          <p class="pd-desc">{project.description}</p>
          {project.tags.length > 0 && (
            <div class="prj-tags pd-tags">
              {project.tags.map((tag) => <span class="prj-tag">{tag}</span>)}
            </div>
          )}

          <div class="pd-actions">
            <a class="button button-primary" href={project.href} target="_blank" rel="noopener noreferrer">
              Visitar {host}
              <svg class="pixel-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M11.3333 14H3.33333V12.6667H11.3333V14ZM3.33333 12.6667H2V4.66667H3.33333V12.6667ZM12.6667 12.6667H11.3333V8.66667H12.6667V12.6667ZM7.33333 10H6V8.66667H7.33333V10ZM8.66667 8.66667H7.33333V7.33333H8.66667V8.66667ZM10 7.33333H8.66667V6H10V7.33333ZM14 7.33333H12.6667V4.66667H11.3333V3.33333H8.66667V2H14V7.33333ZM11.3333 6H10V4.66667H11.3333V6ZM7.33333 4.66667H3.33333V3.33333H7.33333V4.66667Z" /></svg>
            </a>
            {project.id && project.likes !== undefined && (
              <LikeButton projectId={project.id} title={project.title} likes={project.likes} size="lg" />
            )}
          </div>

          <p class="pd-owner">
            ¿Es tu proyecto?{" "}
            <button class="pd-owner-link" type="button" data-open-modal>Solicita cambios</button>{" "}
            (logo, descripción, fundadores o categorías).
          </p>

          {engagement && project.id && (
            <section class="pd-comments" aria-labelledby="pd-comments-title">
              <h2 id="pd-comments-title" class="pd-comments-title">
                Comentarios {comments.length > 0 && <span class="pd-comments-count">({comments.length})</span>}
              </h2>

              {comments.length === 0 ? (
                <p class="pd-comments-empty">Aún no hay comentarios. Deja el primero.</p>
              ) : (
                <ol class="pd-comment-list">
                  {comments.map((comment) => (
                    <li class="pd-comment">
                      <p class="pd-comment-meta">
                        <strong>{comment.author}</strong>
                        <time datetime={comment.createdAt}>{dateFormat.format(new Date(comment.createdAt))}</time>
                      </p>
                      <p class="pd-comment-body">{comment.body}</p>
                    </li>
                  ))}
                </ol>
              )}

              <form class="pd-comment-form" data-comment-form data-project-id={project.id}>
                <input class="honeypot" type="text" name="contact_email" tabindex="-1" autocomplete="off" aria-hidden="true" hidden />
                <input type="hidden" name="submitted_at" value={Date.now()} />
                <label class="field" data-field="autor">
                  <span class="field-label">Tu nombre</span>
                  <input class="field-input" type="text" name="autor" required minlength="2" maxlength={COMMENT_AUTHOR_MAX} autocomplete="name" />
                  <span class="field-error" data-field-error hidden></span>
                </label>
                <label class="field" data-field="comentario">
                  <span class="field-label">Comentario</span>
                  <div class="field-textarea-box">
                    <textarea class="field-textarea" name="comentario" rows="3" required minlength="3" maxlength={COMMENT_BODY_MAX} placeholder="Feedback, preguntas o felicitaciones. Sé amable 🙂"></textarea>
                    <span class="field-counter" data-comment-counter>0/{COMMENT_BODY_MAX}</span>
                  </div>
                  <span class="field-error" data-field-error hidden></span>
                </label>
                {TURNSTILE_SITE_KEY && (
                  <div class="field" data-field="captcha">
                    <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-theme="dark"></div>
                    <span class="field-error" data-field-error hidden></span>
                  </div>
                )}
                <div class="pd-comment-footer">
                  <p class="pd-comment-note">Los comentarios se publican después de una revisión rápida del equipo.</p>
                  <button class="modal-submit" type="submit">Comentar</button>
                </div>
                <p class="form-status" data-comment-status role="status" hidden></p>
              </form>
            </section>
          )}
        </>
      )}
    </div>
  </section>

  {project && <ProjectFormModal mode="edit" project={project} />}
</BaseLayout>

<script>
  import "../../scripts/likes";

  const form = document.querySelector<HTMLFormElement>("[data-comment-form]");
  if (form) {
    const statusEl = form.querySelector<HTMLElement>("[data-comment-status]");
    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const textarea = form.querySelector<HTMLTextAreaElement>('textarea[name="comentario"]');
    const counter = form.querySelector("[data-comment-counter]");
    const max = textarea?.maxLength ?? 600;
    textarea?.addEventListener("input", () => {
      if (counter && textarea) counter.textContent = `${textarea.value.length}/${max}`;
    });

    const fieldError = (field: string) =>
      form.querySelector<HTMLElement>(`[data-field="${field}"] [data-field-error]`);
    const clearErrors = () => {
      form.querySelectorAll<HTMLElement>("[data-field-error]").forEach((el) => { el.hidden = true; });
      form.querySelectorAll("[aria-invalid]").forEach((el) => el.setAttribute("aria-invalid", "false"));
      if (statusEl) statusEl.hidden = true;
    };
    const setStatus = (message: string, isError: boolean) => {
      if (!statusEl) return;
      statusEl.textContent = message;
      statusEl.classList.toggle("is-error", isError);
      statusEl.hidden = false;
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      clearErrors();
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = "Enviando…";
      }
      try {
        const response = await fetch(
          `/api/projects/${encodeURIComponent(form.dataset.projectId ?? "")}/comments`,
          { method: "POST", body: new FormData(form) },
        );
        const data = (await response.json().catch(() => null)) as
          | { ok?: boolean; error?: string; field?: string }
          | null;
        if (!response.ok || !data?.ok) {
          const message = data?.error ?? "No se pudo enviar tu comentario.";
          const el = data?.field ? fieldError(data.field) : null;
          if (el) {
            el.textContent = message;
            el.hidden = false;
            const input = form.querySelector<HTMLElement>(`[name="${data?.field}"]`);
            input?.setAttribute("aria-invalid", "true");
            input?.focus();
          } else {
            setStatus(message, true);
          }
          return;
        }
        form.reset();
        if (counter) counter.textContent = `0/${max}`;
        setStatus("¡Gracias! Tu comentario aparecerá cuando el equipo lo revise.", false);
      } catch {
        setStatus("Hubo un problema de conexión. Intentá de nuevo.", true);
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = "Comentar";
        }
      }
    });
  }
</script>
