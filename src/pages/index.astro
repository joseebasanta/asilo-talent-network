---
import "../styles/fonts.css";
import "../styles/global.css";
import ProjectDirectory from "../components/ProjectDirectory.astro";
import { projects } from "../data/projects";

export const prerender = true;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#000a11" />
    <meta
      name="description"
      content="La comunidad de builders de Venezuela: developers, diseñadores y emprendedores que construyen con IA juntos."
    />
    <title>Asilo Builders</title>
    <link rel="preload" href="/fonts/doto.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-sans.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="#contenido" aria-label="Asilo Builders, inicio">
          <img class="brand-mark" src="/logo-asilo-builders.svg" alt="" aria-hidden="true" />
        </a>
        <nav class="nav-links" aria-label="Navegación principal">
          <a href="#comunidad">Comunidad</a>
          <a href="#proyectos">Proyectos</a>
          <a href="#que-es-asilo">Sobre nosotros</a>
        </nav>
        <a class="join" href="#unete">
          Unete
          <svg class="pixel-icon" viewBox="0 0 17 17" fill="none" aria-hidden="true">
            <path d="M4.8 13.1H13.2V14.5H4.8V13.1ZM4.8 0.5H13.2V1.9H4.8V0.5ZM13.2 1.9H14.6V3.3H13.2V1.9ZM3.4 1.9H4.8V3.3H3.4V1.9ZM3.4 11.7H4.8V13.1H3.4V11.7ZM13.2 11.7H14.6V13.1H13.2V11.7ZM2 3.3H3.4V11.7H2V3.3ZM14.6 3.3H16V11.7H14.6V3.3ZM5.5 8.2H6.9V9.6H5.5V8.2ZM6.9 9.6H11.1V11H6.9V9.6ZM11.1 8.2H12.5V9.6H11.1V8.2ZM6.2 4.7H7.6V6.1H6.2V4.7ZM10.4 4.7H11.8V6.1H10.4V4.7Z" fill="currentColor" />
          </svg>
        </a>
      </div>
    </header>
    <main id="contenido">
      <div class="hero">
        <canvas id="ascii" aria-hidden="true"></canvas>
        <div class="hero-veil" aria-hidden="true"></div>
        <section class="hero-content" aria-labelledby="hero-title">
        <p class="hero-eyebrow">
          <img class="hero-eyebrow-brace" src="/icon-bracket-left.svg" alt="" aria-hidden="true" width="8" height="24" />
          <span class="hero-eyebrow-count">+130</span>
          <span class="hero-eyebrow-label">Builders forman parte</span>
          <img class="hero-eyebrow-brace" src="/icon-bracket-right.svg" alt="" aria-hidden="true" width="8" height="24" />
        </p>
        <h1 id="hero-title">La comunidad de<br />builders de Venezuela</h1>
        <p class="hero-sub">
          Un espacio donde construir productos y crecer con IA es nuestro día a día. Impulsado por Asilo Digital.
        </p>
        <div class="actions">
          <a class="button button-primary" href="#unete">
            Unete a la comunidad
            <svg class="pixel-icon" viewBox="0 0 17 17" fill="none" aria-hidden="true">
              <path d="M4.8 13.1H13.2V14.5H4.8V13.1ZM4.8 0.5H13.2V1.9H4.8V0.5ZM13.2 1.9H14.6V3.3H13.2V1.9ZM3.4 1.9H4.8V3.3H3.4V1.9ZM3.4 11.7H4.8V13.1H3.4V11.7ZM13.2 11.7H14.6V13.1H13.2V11.7ZM2 3.3H3.4V11.7H2V3.3ZM14.6 3.3H16V11.7H14.6V3.3ZM5.5 8.2H6.9V9.6H5.5V8.2ZM6.9 9.6H11.1V11H6.9V9.6ZM11.1 8.2H12.5V9.6H11.1V8.2ZM6.2 4.7H7.6V6.1H6.2V4.7ZM10.4 4.7H11.8V6.1H10.4V4.7Z" fill="currentColor" />
            </svg>
          </a>
          <a class="button button-secondary" href="#proyectos">Ver proyectos</a>
        </div>
        </section>
      </div>

    <span id="comunidad" class="fragment-alias" aria-hidden="true"></span>
    <span id="beneficios" class="fragment-alias" aria-hidden="true"></span>
    <section class="wwd" id="que-hacemos" aria-labelledby="wwd-title">
      <div class="section-inner">
        <h2 id="wwd-title">¿QUE HACEMOS?</h2>
        <div class="wwd-grid">
          <article class="wwd-item">
            <svg class="wwd-icon" viewBox="0 0 40 40" fill="none" aria-hidden="true">
              <path d="M21.6641 38.3385H18.3307V35.0052H21.6641V38.3385ZM18.3307 35.0052H14.9974V31.6719H18.3307V35.0052ZM24.9974 35.0052H21.6641V31.6719H24.9974V35.0052ZM14.9974 31.6719H11.6641V28.3385H14.9974V31.6719ZM21.6641 31.6719H18.3307V26.6719H21.6641V31.6719ZM28.3307 31.6719H24.9974V28.3385H28.3307V31.6719ZM11.6641 28.3385H8.33073V25.0052H11.6641V28.3385ZM31.6641 28.3385H28.3307V25.0052H31.6641V28.3385ZM18.3307 26.6719H14.9974V21.6719H18.3307V26.6719ZM24.9974 26.6719H21.6641V21.6719H24.9974V26.6719ZM8.33073 25.0052H4.9974V21.6719H8.33073V25.0052ZM34.9974 25.0052H31.6641V21.6719H34.9974V25.0052ZM14.9974 15.0052H24.9974V10.0052H28.3307V15.0052H34.9974V11.6719H38.3307V21.6719H34.9974V18.3385H28.3307V21.6719H24.9974V18.3385H14.9974V21.6719H11.6641V18.3385H4.9974V21.6719H1.66406V11.6719H4.9974V15.0052H11.6641V10.0052H14.9974V15.0052ZM8.33073 11.6719H4.9974V8.33854H8.33073V11.6719ZM34.9974 11.6719H31.6641V8.33854H34.9974V11.6719ZM24.9974 10.0052H21.6641V5.00521H18.3307V10.0052H14.9974V5.00521H11.6641V1.67188H28.3307V5.00521H24.9974V10.0052ZM11.6641 8.33854H8.33073V5.00521H11.6641V8.33854ZM31.6641 8.33854H28.3307V5.00521H31.6641V8.33854Z" fill="currentColor" />
            </svg>
            <h3>Reunir el talento</h3>
            <p>Hacer visible a quienes construyen en Venezuela, dentro y fuera del país.</p>
          </article>
          <article class="wwd-item">
            <svg class="wwd-icon" viewBox="0 0 40 40" fill="none" aria-hidden="true">
              <path d="M13.332 33.3359H23.332V36.6693H9.9987V33.3359H6.66536V30.0026H13.332V33.3359ZM33.332 30.0026H36.6654V33.3359H33.332V36.6693H29.9987V33.3359H26.6654V30.0026H29.9987V26.6693H33.332V30.0026ZM6.66536 30.0026H3.33203V10.0026H6.66536V30.0026ZM23.332 30.0026H13.332V26.6693H23.332V30.0026ZM23.332 23.3359H16.6654V20.0026H23.332V23.3359ZM36.6654 23.3359H33.332V10.0026H36.6654V23.3359ZM16.6654 20.0026H13.332V13.3359H16.6654V20.0026ZM26.6654 20.0026H23.332V13.3359H26.6654V20.0026ZM23.332 13.3359H16.6654V10.0026H23.332V13.3359ZM9.9987 10.0026H6.66536V6.66927H9.9987V10.0026ZM33.332 10.0026H29.9987V6.66927H33.332V10.0026ZM29.9987 6.66927H9.9987V3.33594H29.9987V6.66927Z" fill="currentColor" />
            </svg>
            <h3>Dinamizar las relaciones</h3>
            <p>Networking con propósito entre developers, diseñadores y founders.</p>
          </article>
          <article class="wwd-item">
            <svg class="wwd-icon" viewBox="0 0 40 40" fill="none" aria-hidden="true">
              <path d="M0 5H21.6667V8.33333H0V5ZM0 31.6667H18.3333V35H0V31.6667Z" fill="currentColor" />
              <path d="M18.3333 5H40V8.33333H18.3333V5ZM21.6667 31.6667H40V35H21.6667V31.6667ZM18.3333 8.33333H21.6667V38.3333H18.3333V8.33333ZM0 8.33333H3.33333V31.6667H0V8.33333ZM36.6667 8.33333H40V31.6667H36.6667V8.33333ZM25 11.6667H33.3333V15H25V11.6667ZM25 18.3333H33.3333V21.6667H25V18.3333ZM25 25H28.3333V28.3333H25V25Z" fill="currentColor" />
            </svg>
            <h3>Acelerar el aprendizaje</h3>
            <p>Dejar de construir solo. Comparte el proceso, no solo el resultado.</p>
          </article>
        </div>
      </div>
    </section>

    <span id="talent" class="fragment-alias" aria-hidden="true"></span>
    <span id="unete" class="fragment-alias" aria-hidden="true"></span>
    <section class="qeb" id="que-es-asilo" aria-labelledby="qeb-title">
      <div class="qeb-inner">
        <div class="qeb-titles">
          <p class="qeb-eyebrow">ok, pero</p>
          <h2 id="qeb-title">¿Qué es ASILO Builders?</h2>
        </div>
        <p class="qeb-copy">
          Es el laboratorio colectivo donde construimos juntos. El lugar para tomar una idea y convertirla en un producto, una línea de código, un diseño o una empresa. Construimos en público, aprendemos haciendo y lanzamos soluciones que atienden necesidades reales.
        </p>
        <a class="qeb-cta" href="#unete">UNETE A LA COMUNIDAD</a>
      </div>
    </section>
    <ProjectDirectory projects={projects} />
    <section class="cta" id="unete-cta" aria-labelledby="cta-title">
      <div class="cta-inner">
        <div class="cta-titles">
          <h2 id="cta-title" class="cta-title">Deja de construir solo</h2>
          <p class="cta-sub">Sé parte de los +130 builders venezolanos que están haciendo la diferencia.</p>
        </div>
        <a class="button button-primary" href="#unete">
          Llenar formulario
          <svg class="pixel-icon" viewBox="0 0 17 17" fill="none" aria-hidden="true">
            <path d="M4.8 13.1H13.2V14.5H4.8V13.1ZM4.8 0.5H13.2V1.9H4.8V0.5ZM13.2 1.9H14.6V3.3H13.2V1.9ZM3.4 1.9H4.8V3.3H3.4V1.9ZM3.4 11.7H4.8V13.1H3.4V11.7ZM13.2 11.7H14.6V13.1H13.2V11.7ZM2 3.3H3.4V11.7H2V3.3ZM14.6 3.3H16V11.7H14.6V3.3ZM5.5 8.2H6.9V9.6H5.5V8.2ZM6.9 9.6H11.1V11H6.9V9.6ZM11.1 8.2H12.5V9.6H11.1V8.2ZM6.2 4.7H7.6V6.1H6.2V4.7ZM10.4 4.7H11.8V6.1H10.4V4.7Z" fill="currentColor" />
          </svg>
        </a>
      </div>
    </section>
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <img class="footer-logo" src="/logo-asilo-builders.svg" alt="Asilo Builders" width="156" height="28" />
          <h2 class="footer-title">La comunidad #1 de tecnologia de Venezuela</h2>
          <p class="footer-tagline">Impulsado por Asilo Digital.</p>
        </div>
        <div class="footer-links">
          <ul class="footer-linklist">
            <li><a href="mailto:hello@asilodigital.com">hello@asilodigital.com</a></li>
            <li><a href="#">WhatsApp</a></li>
            <li><a href="#proyectos">Proyectos</a></li>
            <li><a href="#que-es-asilo">Sobre nosotros</a></li>
            <li>
              <a class="footer-top" href="#contenido">
                Volver arriba
                <svg class="footer-arrow" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M7.33333 13.3337H8.66667V2.66699H7.33333V13.3337ZM8.66667 5.33366H10V4.00033H8.66667V5.33366ZM10 6.66699H11.3333V5.33366H10V6.66699ZM11.3333 8.00033H12.6667V6.66699H11.3333V8.00033ZM7.33333 5.33366H6V4.00033H7.33333V5.33366Z" /><path d="M10 6.66634H4.66667V5.33301H10V6.66634ZM11.3333 7.99967H3.33334V6.66634H11.3333V7.99967Z" /></svg>
              </a>
            </li>
          </ul>
          <div class="footer-social">
            <a href="#" aria-label="Instagram">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M16 3.24219H8C5.23858 3.24219 3 5.48077 3 8.24219V16.2422C3 19.0036 5.23858 21.2422 8 21.2422H16C18.7614 21.2422 21 19.0036 21 16.2422V8.24219C21 5.48077 18.7614 3.24219 16 3.24219ZM19.25 16.2422C19.2445 18.0348 17.7926 19.4867 16 19.4922H8C6.20735 19.4867 4.75549 18.0348 4.75 16.2422V8.24219C4.75549 6.44954 6.20735 4.99768 8 4.99219H16C17.7926 4.99768 19.2445 6.44954 19.25 8.24219V16.2422ZM16.75 8.49219C17.3023 8.49219 17.75 8.04447 17.75 7.49219C17.75 6.93991 17.3023 6.49219 16.75 6.49219C16.1977 6.49219 15.75 6.93991 15.75 7.49219C15.75 8.04447 16.1977 8.49219 16.75 8.49219ZM12 7.74219C9.51472 7.74219 7.5 9.75691 7.5 12.2422C7.5 14.7275 9.51472 16.7422 12 16.7422C14.4853 16.7422 16.5 14.7275 16.5 12.2422C16.5027 11.0479 16.0294 9.90176 15.1849 9.05727C14.3404 8.21278 13.1943 7.73953 12 7.74219ZM9.25 12.2422C9.25 13.761 10.4812 14.9922 12 14.9922C13.5188 14.9922 14.75 13.761 14.75 12.2422C14.75 10.7234 13.5188 9.49219 12 9.49219C10.4812 9.49219 9.25 10.7234 9.25 12.2422Z" /></svg>
            </a>
            <a href="#" aria-label="X">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.1761 4.24219H19.9362L13.9061 11.0196L21 20.2422H15.4456L11.0951 14.6488L6.11723 20.2422H3.35544L9.80517 12.993L3 4.24219H8.69545L12.6279 9.35481L17.1761 4.24219ZM16.2073 18.6176H17.7368L7.86441 5.78147H6.2232L16.2073 18.6176Z" /></svg>
            </a>
            <a href="#" aria-label="LinkedIn">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M4.5 3.24219C3.67157 3.24219 3 3.91376 3 4.74219V19.7422C3 20.5706 3.67157 21.2422 4.5 21.2422H19.5C20.3284 21.2422 21 20.5706 21 19.7422V4.74219C21 3.91376 20.3284 3.24219 19.5 3.24219H4.5ZM8.52076 7.24491C8.52639 8.20116 7.81061 8.79038 6.96123 8.78616C6.16107 8.78194 5.46357 8.14491 5.46779 7.24632C5.47201 6.40116 6.13998 5.72194 7.00764 5.74163C7.88795 5.76132 8.52639 6.40679 8.52076 7.24491ZM12.2797 10.0039H9.75971H9.7583V18.5638H12.4217V18.3641C12.4217 17.9842 12.4214 17.6042 12.4211 17.2241C12.4203 16.2103 12.4194 15.1954 12.4246 14.1819C12.426 13.9358 12.4372 13.6799 12.5005 13.445C12.7381 12.5675 13.5271 12.0008 14.4074 12.1401C14.9727 12.2286 15.3467 12.5563 15.5042 13.0893C15.6013 13.4225 15.6449 13.7811 15.6491 14.1285C15.6605 15.1761 15.6589 16.2237 15.6573 17.2714C15.6567 17.6412 15.6561 18.0112 15.6561 18.381V18.5624H18.328V18.3571C18.328 17.9051 18.3278 17.4532 18.3275 17.0013C18.327 15.8718 18.3264 14.7423 18.3294 13.6124C18.3308 13.1019 18.276 12.5985 18.1508 12.1049C17.9638 11.3708 17.5771 10.7633 16.9485 10.3246C16.5027 10.0124 16.0133 9.81129 15.4663 9.78879C15.404 9.7862 15.3412 9.78281 15.2781 9.7794C14.9984 9.76428 14.7141 9.74892 14.4467 9.80285C13.6817 9.95613 13.0096 10.3063 12.5019 10.9236C12.4429 10.9944 12.3852 11.0663 12.2991 11.1736L12.2797 11.1979V10.0039ZM5.68164 18.5666H8.33242V10.0095H5.68164V18.5666Z" /></svg>
            </a>
          </div>
        </div>
      </div>
    </footer>
    <script>
      import "../scripts/ascii-background.js";
      import "../scripts/ascii-cursor.js";
    </script>
  </body>
</html>
