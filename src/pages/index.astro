---
import "../styles/fonts.css";
import "../styles/global.css";
import "../styles/motion.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SeoHead from "../components/SeoHead.astro";
import ThemeInit from "../components/ThemeInit.astro";
import ProjectDirectory from "../components/ProjectDirectory.astro";
import LandingCtas from "../components/LandingCtas.astro";
import { loadApprovedProjects } from "../lib/projects-loader";

import { loadBuildersCount } from "../lib/builders-loader";

const [projects, buildersCount] = await Promise.all([
  loadApprovedProjects(),
  loadBuildersCount(),
]);

export const prerender = false;
Astro.response.headers.set("Cache-Control", "no-store");

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://builders.asilodigital.com";
const canonical = `${siteUrl}/`;
const pageTitle = "Asilo Builders — La comunidad de builders de Venezuela";
const pageDescription =
  "Asilo Builders | La comunidad de builders de Venezuela. Aprendemos y construimos.";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#0f1011" />
    <ThemeInit />
    <SeoHead title={pageTitle} description={pageDescription} canonical={canonical} />
    <link rel="icon" href="/favicon.svg?v=20260911" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <SiteHeader home />
    <main id="contenido">
      <div class="hero">
        <canvas id="ascii" data-ascii-src="/ascii-skyline.png" aria-hidden="true"></canvas>
        <div class="hero-veil" aria-hidden="true"></div>
        <section class="hero-content" aria-labelledby="hero-title">
        <p class="hero-eyebrow">
          <img class="hero-eyebrow-brace" src="/icon-bracket-left.svg" alt="" aria-hidden="true" width="8" height="24" />
          {buildersCount !== null && (
            <span class="hero-eyebrow-count">+{buildersCount.toLocaleString("es-VE")}</span>
          )}
          <span class="hero-eyebrow-label">Builders forman parte</span>
          <img class="hero-eyebrow-brace" src="/icon-bracket-right.svg" alt="" aria-hidden="true" width="8" height="24" />
        </p>
        <h1 id="hero-title">La comunidad de<br /><em>builders</em> de Venezuela</h1>
        <p class="hero-sub">
          Un espacio donde construir productos y crecer con IA es nuestro día a día. Impulsado por <a class="asilo-digital-link" href="https://www.asilodigital.com/">Asilo Digital</a>.
        </p>
        <LandingCtas />
        <p class="hero-note">
          <span class="account-out">Es gratis. Entra con Google o con tu correo.</span>
          <a href="/proyectos">Explorar proyectos</a>
        </p>
        </section>
      </div>

    <span id="comunidad" class="fragment-alias" aria-hidden="true"></span>
    <span id="beneficios" class="fragment-alias" aria-hidden="true"></span>
    <span id="talent" class="fragment-alias" aria-hidden="true"></span>
    <span id="unete" class="fragment-alias" aria-hidden="true"></span>
    <ProjectDirectory projects={projects} />
    <section class="cta" id="unete-cta" aria-labelledby="cta-title">
      <div class="cta-inner">
        <div class="cta-titles">
          <h2 id="cta-title" class="cta-title" data-decode>Deja de construir solo</h2>
          <p class="cta-sub" data-reveal="fade" style="--reveal-i: 1">¿Tienes un proyecto en marcha, usuarios reales o una idea que ya estás ejecutando? Cuéntanos qué estás construyendo.</p>
        </div>
        <div class="cta-actions" data-reveal="fade" style="--reveal-i: 2">
          <LandingCtas />
        </div>
      </div>
    </section>
    </main>
    <SiteFooter home />
    <script>
      import { initAsciiCursor } from "../scripts/ascii-cursor.js";
      initAsciiCursor();
      import "../scripts/scroll-reveal.js";
    </script>
  </body>
</html>
