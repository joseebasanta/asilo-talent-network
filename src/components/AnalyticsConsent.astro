<aside class="analytics-consent" id="analytics-consent" aria-labelledby="analytics-consent-title" hidden>
  <div class="analytics-consent-copy">
    <p class="analytics-consent-kicker">PRIVACIDAD</p>
    <h2 id="analytics-consent-title">¿Nos ayudás a mejorar Asilo?</h2>
    <p>Usamos analítica y sesiones anónimas para entender qué funciona y corregir problemas. Los campos de formularios permanecen ocultos.</p>
  </div>
  <div class="analytics-consent-actions">
    <button class="analytics-consent-reject" type="button" data-analytics-decline>No, gracias</button>
    <button class="button button-primary analytics-consent-accept" type="button" data-analytics-accept>Aceptar analítica</button>
  </div>
</aside>

<script>
  import { isAnalyticsConfigured, startAnalytics } from "../scripts/analytics";

  const storageKey = "asilo-analytics-consent";
  const banner = document.getElementById("analytics-consent");
  const saved = () => {
    try { return localStorage.getItem(storageKey); } catch { return null; }
  };
  const save = (value: "accepted" | "declined") => {
    try { localStorage.setItem(storageKey, value); } catch { /* Consent remains session-only. */ }
  };

  if (isAnalyticsConfigured && banner) {
    if (saved() === "accepted") startAnalytics();
    else if (!saved()) banner.hidden = false;

    banner.querySelector("[data-analytics-accept]")?.addEventListener("click", () => {
      save("accepted");
      startAnalytics();
      banner.hidden = true;
    });
    banner.querySelector("[data-analytics-decline]")?.addEventListener("click", () => {
      save("declined");
      banner.hidden = true;
    });
  }
</script>

<style>
  .analytics-consent {
    position: fixed;
    z-index: 20;
    right: 1rem;
    bottom: 1rem;
    max-width: 34rem;
    padding: 1.25rem;
    border: 1px solid var(--line, #32424c);
    background: #06131b;
    box-shadow: 8px 8px 0 #d6ff3f;
  }
  .analytics-consent-kicker { margin: 0 0 .4rem; color: #d6ff3f; font: 700 .72rem/1 var(--font-mono, monospace); letter-spacing: .12em; }
  .analytics-consent h2 { margin: 0; font-size: 1.2rem; }
  .analytics-consent p:not(.analytics-consent-kicker) { margin: .5rem 0 0; color: #c3d0d6; font-size: .88rem; line-height: 1.45; }
  .analytics-consent-actions { display: flex; flex-wrap: wrap; gap: .75rem; align-items: center; margin-top: 1rem; }
  .analytics-consent-reject { border: 0; padding: .65rem .2rem; color: #c3d0d6; background: transparent; text-decoration: underline; cursor: pointer; }
  .analytics-consent-accept { border: 0; cursor: pointer; }
  @media (max-width: 40rem) { .analytics-consent { right: .75rem; bottom: .75rem; left: .75rem; max-width: none; } }
</style>
