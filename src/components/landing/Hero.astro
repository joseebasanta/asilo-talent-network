---
import { CTA_HREF, CTA_LABEL, hero, projects } from "../../data/landing";
---
<section class="l-hero" id="inicio" aria-labelledby="hero-title">
  <div class="l-hero-field">
    {/* Cuadrícula que toma color donde pasa el puntero (grid-pulse.ts), debajo del contenido.
        La luz se atenúa detrás de las líneas de texto marcadas con data-grid-avoid. */}
    <div class="l-grid-pulse" data-grid-pulse aria-hidden="true"><canvas></canvas></div>
    <div class="l-container">
    <div class="l-hero-copy">
      <h1 class="l-display" id="hero-title" data-reveal data-grid-avoid>{hero.title}</h1>
      <p class="l-lead" data-reveal data-grid-avoid style="--reveal-i: 1">{hero.subtitle}</p>
      <div class="l-hero-ctas" data-reveal data-grid-avoid style="--reveal-i: 2">
        <a class="l-btn l-btn--primary" href={CTA_HREF}>{CTA_LABEL}</a>
        <a class="l-btn l-btn--ghost" href={hero.secondaryCta.href}>{hero.secondaryCta.label}</a>
      </div>
    </div>

    <div class="l-logos">
      <div class="l-logos-track">
        <ul aria-label="Clientes">
          {hero.clientLogos.map((logo) => <li><img src={logo.src} alt={logo.name} width="120" height="24" /></li>)}
        </ul>
        {/* Copia para el scroll infinito: oculta a lectores de pantalla. */}
        <ul aria-hidden="true">
          {hero.clientLogos.map((logo) => <li><img src={logo.src} alt="" width="120" height="24" /></li>)}
        </ul>
      </div>
    </div>
    </div>
  </div>

  <div class="l-container">
    <ul class="l-projects" aria-label="Proyectos recientes">
      {projects.map((project, i) => (
        <li class="l-project" data-reveal style={`--reveal-i: ${i % 3}`}>
          <article>
            <div class="l-media">
              <img src={project.image.src} alt={project.image.alt} width="760" height="800" loading={i < 3 ? "eager" : "lazy"} decoding="async" />
            </div>
            <div class="l-project-body">
              <div class="l-project-row">
                <h3>{project.name}</h3>
                <span class="l-project-year">{project.year}</span>
              </div>
              <p>{project.tags}</p>
            </div>
          </article>
        </li>
      ))}
    </ul>
  </div>
</section>
