---
import { CTA_HREF, CTA_LABEL, services } from "../../data/landing";
---
<section class="l-section" id="servicios" aria-labelledby="servicios-title">
  <div class="l-container">
    <div class="l-section-head" data-reveal>
      <div>
        <span class="l-eyebrow">Servicios</span>
        <h2 class="l-heading" id="servicios-title">Tres formas de trabajar juntos.</h2>
      </div>
    </div>

    {/* <details name> hace el acordeón exclusivo de forma nativa; landing.ts lo replica donde no hay soporte.
        El primer servicio empieza abierto, como en el diseño (Figma: Asilo Services, nodo 24:121). */}
    <div class="l-accordion" data-accordion data-reveal style="--reveal-i: 1">
      {services.map((service, i) => (
        <details class="l-acc" name="servicios" open={i === 0}>
          <summary>
            <span class="l-acc-num">{service.number}</span>
            <span class="l-acc-name">{service.name}</span>
            {/* "+" que pierde el trazo vertical al abrir y queda en "−". */}
            <svg class="l-acc-icon" width="40" height="40" viewBox="0 0 40 40" fill="none" aria-hidden="true">
              <path d="M8 20H32" stroke="currentColor" stroke-width="3" />
              <path class="l-acc-icon-v" d="M20 8V32" stroke="currentColor" stroke-width="3" />
            </svg>
          </summary>
          <div class="l-acc-body">
            {service.stack ? (
              /* Pantallas en cascada que avanzan una tras otra (phone-stack.ts). Sin JS se ven quietas. */
              <div class="l-media l-acc-media l-stack" data-phone-stack>
                <img class="l-stack-bg" src={service.stack.background} alt="" width="720" height="480" decoding="async" />
                <ul class="l-stack-screens">
                  {service.stack.screens.map((screen, k) => (
                    <li class="l-stack-card" data-stack-card style={`--slot: ${k}`}>
                      <img src={screen.src} alt={screen.alt} width="350" height="707" loading={i === 0 ? "eager" : "lazy"} decoding="async" />
                    </li>
                  ))}
                </ul>
              </div>
            ) : service.image && (
              <div class="l-media l-acc-media">
                <img
                  src={service.image.src}
                  alt={service.image.alt}
                  width="720"
                  height="480"
                  loading={i === 0 ? "eager" : "lazy"}
                  decoding="async"
                />
              </div>
            )}
            <div class="l-acc-content">
              <div class="l-acc-text">
                <p class="l-acc-desc">{service.hook} {service.detail}</p>
                <ul class="l-acc-includes" aria-label="Incluye">
                  {service.includes.map((item) => <li>{item}</li>)}
                </ul>
              </div>
              <a class="l-acc-link" href={CTA_HREF}>
                {CTA_LABEL}
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M2 9H15M10 4L15 9L10 14" stroke="currentColor" stroke-width="1.5" /></svg>
              </a>
            </div>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
