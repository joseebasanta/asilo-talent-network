---
import { faqItems, faqSection } from "../../data/servicios";
import SectionHead from "./SectionHead.astro";

---

<section class="s-faq" id="preguntas" aria-labelledby="preguntas-title">
  <div class="s-faq-inner">
    <div class="s-faq-head">
      <SectionHead tagline={faqSection.tagline} title={faqSection.titleLines} titleId="preguntas-title" align="start" />
    </div>

    <div class="s-faq-list">
      {
        faqItems.map((item, i) => (
          <details class="s-faq-item" name="faq" open={i === 0}>
            <summary class="s-faq-question s-label-lg">
              <span>{item.question}</span>
              <span class="s-icon s-faq-icon" style="--icon: url(/servicios/icons/close.svg)"></span>
            </summary>
            <div class="s-faq-answer-wrap">
              <p class="s-faq-answer s-paragraph-md">{item.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { initFaq } from "../../scripts/servicios-faq";

  document.querySelectorAll<HTMLElement>(".s-faq-list").forEach((list) => initFaq(list));
</script>
