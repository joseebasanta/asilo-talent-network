---
import { CONTACT_EMAIL, CTA_HREF, CTA_LABEL, faqItems, faqSection } from "../../data/servicios";
import SectionHead from "./SectionHead.astro";

const { card } = faqSection;
---

<section class="s-faq" id="preguntas" aria-labelledby="preguntas-title">
  <div class="s-faq-inner">
    <div class="s-faq-head">
      <SectionHead tagline={faqSection.tagline} title={faqSection.title} titleId="preguntas-title" align="start" />
    </div>

    <aside class="s-faq-card" aria-labelledby="faq-card-title">
      <div class="s-faq-card-text">
        <h3 class="s-faq-card-title s-title-h6" id="faq-card-title">{card.title}</h3>
        <p class="s-faq-card-body s-paragraph-sm">{card.body}</p>
      </div>
      <a class="s-btn s-btn--primary s-label-sm" href={CTA_HREF}>{CTA_LABEL}</a>
      <p class="s-faq-card-email s-paragraph-sm">
        {card.emailLabel} <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
      </p>
    </aside>

    <div class="s-faq-list">
      {
        faqItems.map((item, i) => (
          <details class="s-faq-item" name="faq" open={i === 0}>
            <summary class="s-faq-question s-label-lg">
              <span>{item.question}</span>
              <span class="s-icon s-faq-icon" style="--icon: url(/servicios/icons/close.svg)"></span>
            </summary>
            <div class="s-faq-answer-wrap">
              <p class="s-faq-answer s-paragraph-md">{item.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { initFaq } from "../../scripts/servicios-faq";

  document.querySelectorAll<HTMLElement>(".s-faq-list").forEach((list) => initFaq(list));
</script>
