---
// Hero de la landing de servicios v2 (Figma: Asilo Services, nodo 91:7203).
import { CTA_HREF, CTA_LABEL, clientLogos, hero } from "../../data/servicios";

// La franja se repite cuatro veces y se desplaza la mitad de su ancho en bucle: así no queda un hueco
// ni en pantallas anchas. Solo la primera copia se anuncia; las demás son decorativas.
const copies = [0, 1, 2, 3];
---
<section class="s-hero" id="inicio" aria-labelledby="hero-title">
  <!-- Fondo: grilla de píxeles que aparece en onda desde el centro, con viñeta (adaptado de "pixel-perfect-hero"). -->
  <div class="s-hero-bg" aria-hidden="true">
    <canvas class="s-hero-pixels" data-hero-pixels></canvas>
    <div class="s-hero-vignette"></div>
  </div>
  <div class="s-hero-inner">
    <div class="s-hero-text">
      <h1 class="s-hero-title" id="hero-title">
        {hero.titleLines.map((line, i) => <span class="s-hero-title-line">{i > 0 && " "}{line}</span>)}
      </h1>
      <p class="s-hero-lead s-paragraph-lg">{hero.subtitle}</p>
    </div>
    <div class="s-hero-actions">
      <a class="s-btn s-btn--lg s-btn--primary s-label-md" href={CTA_HREF}>{CTA_LABEL}</a>
      <a class="s-btn s-btn--lg s-btn--secondary s-label-md" href={hero.secondaryCta.href}>{hero.secondaryCta.label}</a>
    </div>
  </div>
  <div class="s-logos">
    <div class="s-logos-track">
      {
        copies.map((copy) => (
          <ul class="s-logos-set" aria-label={copy === 0 ? "Clientes" : undefined} aria-hidden={copy === 0 ? undefined : "true"}>
            {clientLogos.map((logo) => (
              <li class="s-logos-item">
                <img src={logo.src} alt={copy === 0 ? logo.alt : ""} width="160" height="32" loading="lazy" decoding="async" />
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { initPixels } from "../../scripts/servicios-pixels";

  document.querySelectorAll<HTMLCanvasElement>("[data-hero-pixels]").forEach(initPixels);
</script>
