---
import { footer, footerLegalLinks, footerSocialLinks } from "../../data/servicios";

// Alto de cada columna del brillo (% del más alto): arco escalonado y simétrico, medido de la referencia.
const glowBars = [55, 69, 81, 92, 100, 92, 81, 69, 55];
---

<footer class="s-footer">
  <div class="s-footer-inner">
    <div class="s-footer-top">
      <div class="s-footer-brand">
        <a class="s-footer-logo" href="#contenido" aria-label="Asilo Digital, volver al inicio">
          <span class="s-icon" style="--icon: url(/logo-asilo-digital-white.svg)"></span>
        </a>
        <p class="s-footer-tagline s-title-h5">{footer.tagline}</p>
      </div>
      <ul class="s-footer-social" aria-label="Redes sociales">
        {
          footerSocialLinks.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={`Asilo Digital en ${link.label}`}>
                <span class="s-icon" style={`--icon: url(/servicios/icons/${link.icon}.svg)`}></span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="s-footer-credits s-paragraph-sm">
      <p>{footer.copyright}</p>
      {
        footerLegalLinks.length > 0 && (
          <ul class="s-footer-legal">
            {footerLegalLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
  <div class="s-footer-glow-space" data-footer-glow-space></div>
  <div class="s-footer-glow" aria-hidden="true" data-footer-glow>
    <div class="s-footer-glow-bars">
      <div class="s-footer-glow-rise" data-footer-glow-rise>
        {glowBars.map((h) => <span class="s-footer-glow-bar" style={`--h: ${h}`} />)}
      </div>
    </div>
  </div>
</footer>

<script>
  import { initFooterGlow } from "../../scripts/servicios-footer-glow";

  document.querySelectorAll<HTMLElement>("[data-footer-glow]").forEach((glow) => initFooterGlow(glow));
</script>
