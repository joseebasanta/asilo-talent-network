---
import { projects, projectsSection } from "../../data/servicios";
import SectionHead from "./SectionHead.astro";
---

<section class="s-projects" id="trabajo" aria-labelledby="proyectos-title">
  <div class="s-projects-inner">
    <SectionHead
      tagline={projectsSection.tagline}
      title={projectsSection.title}
      subtitle={projectsSection.subtitle}
      titleId="proyectos-title"
    />

    <ul class="s-projects-grid">
      {
        projects.map((project) => (
          <li class="s-project">
            <img
              class="s-project-image"
              src={project.image.src}
              alt={project.image.alt}
              width="811"
              height="568"
              loading="lazy"
              decoding="async"
            />
            <div class="s-project-body">
              <div class="s-project-text">
                <h3 class="s-project-name s-title-h5">{project.name}</h3>
                <p class="s-project-description s-paragraph-md">{project.description}</p>
              </div>
              <ul class="s-tags" aria-label={`Servicios en ${project.name}`}>
                {project.tags.map((tag) => <li class="s-tag s-label-sm">{tag}</li>)}
              </ul>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
