---
// "Con quién trabajamos" (Figma: Asilo Core): título, bajada y un botón al formulario.
import { CTA_HREF, audienceSection } from "../../data/servicios";
import SectionHead from "./SectionHead.astro";
---

<section class="s-audience" id="con-quien-trabajamos" aria-labelledby="con-quien-trabajamos-title">
  <div class="s-audience-inner">
    <SectionHead
      title={audienceSection.titleLines}
      subtitle={audienceSection.subtitle}
      titleId="con-quien-trabajamos-title"
    />
    <a class="s-btn s-btn--lg s-btn--primary s-label-md" href={CTA_HREF}>{audienceSection.ctaLabel}</a>
  </div>
</section>
