---
// "El problema" (Figma: Asilo Core, "Dolores"): título centrado y tres tarjetas; cada una lleva al servicio que la resuelve.
import { problemCards, problemSection } from "../../data/servicios";
import SectionHead from "./SectionHead.astro";
---

<section class="s-problem" id="problema" aria-labelledby="problema-title">
  <div class="s-problem-inner">
    <SectionHead
      tagline={problemSection.tagline}
      title={problemSection.titleLines}
      subtitle={problemSection.subtitle}
      titleId="problema-title"
    />
    <ul class="s-cards">
      {
        problemCards.map((card) => (
          <li class="s-card">
            <div class="s-card-text">
              <h3 class="s-card-title s-title-h5">{card.title}</h3>
              <p class="s-card-body s-paragraph-sm">{card.body}</p>
            </div>
            {card.link && (
              <a class="s-card-link s-label-sm" href={card.link.href}>
                {card.link.label}
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>
