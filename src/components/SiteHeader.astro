---
// The account controls (sign-in links, avatar menu, bell) live in accounts.css; load it wherever the header is used.
import "../styles/accounts.css";
interface Props { home?: boolean; }
const { home = false } = Astro.props;
const path = Astro.url?.pathname ?? "/";
const isPath = (base: string) => path === base || path.startsWith(`${base}/`);

const links = [
  { label: "Proyectos", href: "/proyectos", current: isPath("/proyectos") },
  { label: "Recursos", href: "/recursos", current: isPath("/recursos") },
];
const joinIcon = "M4.8 13.1H13.2V14.5H4.8V13.1ZM4.8 0.5H13.2V1.9H4.8V0.5ZM13.2 1.9H14.6V3.3H13.2V1.9ZM3.4 1.9H4.8V3.3H3.4V1.9ZM3.4 11.7H4.8V13.1H3.4V11.7ZM13.2 11.7H14.6V13.1H13.2V11.7ZM2 3.3H3.4V11.7H2V3.3ZM14.6 3.3H16V11.7H14.6V3.3ZM5.5 8.2H6.9V9.6H5.5V8.2ZM6.9 9.6H11.1V11H6.9V9.6ZM11.1 8.2H12.5V9.6H11.1V8.2ZM6.2 4.7H7.6V6.1H6.2V4.7ZM10.4 4.7H11.8V6.1H10.4V4.7Z";
---
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={home ? "#contenido" : "/"} aria-label="Asilo Builders, inicio">
          <img class="brand-mark" src="/logo-mark.png" alt="" aria-hidden="true" width="22" height="21" />
          <span class="brand-name">Builders</span>
        </a>
        <nav class="nav-links" aria-label="Navegación principal">
          {links.map((link) => (
            <a href={link.href} aria-current={link.current ? "page" : undefined}>{link.label}</a>
          ))}
        </nav>
        <div class="header-actions">
          <button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="Cambiar a modo claro">
            <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
            <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" /></svg>
          </button>
          <a class="bell account-in" href="/notificaciones" aria-label="Notificaciones" aria-current={isPath("/notificaciones") ? "page" : undefined}>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 17h12l-1.5-2v-4a4.5 4.5 0 0 0-9 0v4L6 17Zm4 3h4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <span class="bell-badge" data-notif-count hidden></span>
          </a>
          <div class="account-out header-account">
            <a class="header-link" href="/entrar">Entrar</a>
            <a class="header-link header-link--outlined" href="/crear-cuenta">Crear cuenta</a>
            <a class="join" href="/onboarding?origen=proyecto">
              Registra tu proyecto
              <svg class="pixel-icon" viewBox="0 0 17 17" fill="none" aria-hidden="true">
                <path d={joinIcon} fill="currentColor" />
              </svg>
            </a>
          </div>
          <div class="account-in header-account">
            <details class="avatar-menu" data-avatar-menu>
              <summary class="avatar-button" aria-label="Menú de tu cuenta">
                <span class="avatar" data-account-avatar aria-hidden="true"></span>
              </summary>
              <div class="avatar-panel">
                <p class="avatar-name" data-account-name></p>
                <a href="/mis-proyectos">Mis proyectos</a>
                <a href="/onboarding?origen=proyecto">Registrar proyecto</a>
                <a href="/perfil">Perfil</a>
                <button type="button" data-sign-out>Salir</button>
              </div>
            </details>
          </div>
        </div>

        <!-- Mobile hamburger (native disclosure; shown ≤760px) -->
        <details class="nav-menu" id="nav-menu">
          <summary class="nav-toggle" aria-label="Abrir menú de navegación">
            <span class="nav-toggle-box" aria-hidden="true"><span></span><span></span><span></span></span>
          </summary>
          <nav class="nav-panel" aria-label="Navegación principal">
            {links.map((link) => (
              <a href={link.href} aria-current={link.current ? "page" : undefined}>{link.label}</a>
            ))}
            <div class="account-out panel-account">
              <a href="/entrar">Entrar</a>
              <a href="/crear-cuenta">Crear cuenta</a>
              <a class="join nav-panel-cta" href="/onboarding?origen=proyecto">
                Registra tu proyecto
                <svg class="pixel-icon" viewBox="0 0 17 17" fill="none" aria-hidden="true">
                  <path d={joinIcon} fill="currentColor" />
                </svg>
              </a>
            </div>
            <div class="account-in panel-account">
              <a href="/mis-proyectos">Mis proyectos</a>
              <a href="/onboarding?origen=proyecto">Registrar proyecto</a>
              <a href="/perfil">Perfil</a>
              <button type="button" data-sign-out>Salir</button>
            </div>
          </nav>
        </details>
      </div>
    </header>
    <script>
      import "../scripts/theme-toggle.ts";
      import "../scripts/header-account.ts";
    </script>
    <script>
      // Enhance the native <details> menu: close on link click, Esc, or outside click.
      const menu = document.getElementById("nav-menu") as HTMLDetailsElement | null;
      if (menu) {
        const close = () => menu.removeAttribute("open");
        menu.querySelectorAll(".nav-panel a").forEach((link) => link.addEventListener("click", close));
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && menu.open) close();
        });
        document.addEventListener("click", (event) => {
          if (menu.open && !menu.contains(event.target as Node)) close();
        });
      }
    </script>
