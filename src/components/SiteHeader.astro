---
interface Props { home?: boolean; }
const { home = false } = Astro.props;
const path = Astro.url?.pathname ?? "/";
const isPath = (base: string) => path === base || path.startsWith(`${base}/`);

const links = [
  { label: "Comunidad", href: home ? "#comunidad" : "/#comunidad" },
  { label: "Proyectos", href: "/proyectos", current: isPath("/proyectos") },
  { label: "Sobre nosotros", href: home ? "#que-es-asilo" : "/#que-es-asilo" },
  { label: "Recursos", href: "/recursos", current: isPath("/recursos") },
];
const joinHref = home ? "#unete" : "/#unete";
const joinIcon = "M4.8 13.1H13.2V14.5H4.8V13.1ZM4.8 0.5H13.2V1.9H4.8V0.5ZM13.2 1.9H14.6V3.3H13.2V1.9ZM3.4 1.9H4.8V3.3H3.4V1.9ZM3.4 11.7H4.8V13.1H3.4V11.7ZM13.2 11.7H14.6V13.1H13.2V11.7ZM2 3.3H3.4V11.7H2V3.3ZM14.6 3.3H16V11.7H14.6V3.3ZM5.5 8.2H6.9V9.6H5.5V8.2ZM6.9 9.6H11.1V11H6.9V9.6ZM11.1 8.2H12.5V9.6H11.1V8.2ZM6.2 4.7H7.6V6.1H6.2V4.7ZM10.4 4.7H11.8V6.1H10.4V4.7Z";
---
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={home ? "#contenido" : "/"} aria-label="Asilo Builders, inicio">
          <img class="brand-mark" src="/logo-asilo-builders.svg" alt="" aria-hidden="true" />
        </a>
        <nav class="nav-links" aria-label="Navegación principal">
          {links.map((link) => (
            <a href={link.href} aria-current={link.current ? "page" : undefined}>{link.label}</a>
          ))}
        </nav>
        <a class="join" href={joinHref}>
          Únete
          <svg class="pixel-icon" viewBox="0 0 17 17" fill="none" aria-hidden="true">
            <path d={joinIcon} fill="currentColor" />
          </svg>
        </a>

        <!-- Mobile hamburger (native disclosure; shown ≤760px) -->
        <details class="nav-menu" id="nav-menu">
          <summary class="nav-toggle" aria-label="Abrir menú de navegación">
            <span class="nav-toggle-box" aria-hidden="true"><span></span><span></span><span></span></span>
          </summary>
          <nav class="nav-panel" aria-label="Navegación principal">
            {links.map((link) => (
              <a href={link.href} aria-current={link.current ? "page" : undefined}>{link.label}</a>
            ))}
            <a class="join nav-panel-cta" href={joinHref}>
              Únete
              <svg class="pixel-icon" viewBox="0 0 17 17" fill="none" aria-hidden="true">
                <path d={joinIcon} fill="currentColor" />
              </svg>
            </a>
          </nav>
        </details>
      </div>
    </header>
    <script>
      // Enhance the native <details> menu: close on link click, Esc, or outside click.
      const menu = document.getElementById("nav-menu") as HTMLDetailsElement | null;
      if (menu) {
        const close = () => menu.removeAttribute("open");
        menu.querySelectorAll(".nav-panel a").forEach((link) => link.addEventListener("click", close));
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && menu.open) close();
        });
        document.addEventListener("click", (event) => {
          if (menu.open && !menu.contains(event.target as Node)) close();
        });
      }
    </script>
