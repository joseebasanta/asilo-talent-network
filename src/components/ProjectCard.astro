---
import type { HTMLAttributes } from "astro/types";
import type { Project } from "../data/projects";
import { projectIconUrl } from "../lib/project-icons";

interface Props extends HTMLAttributes<"a"> {
  project: Project;
}

const { project, ...attributes } = Astro.props;
---

<a class="prj-item" href={project.href} target="_blank" rel="noopener noreferrer" {...attributes}>
  <div class="prj-thumb" aria-hidden="true">
    {project.logoUrl ? (
      <img
        class="prj-logo"
        src={project.logoUrl}
        alt=""
        loading="lazy"
        decoding="async"
      />
    ) : (
      <img class="prj-placeholder" src={project.iconUrl ?? projectIconUrl(project.tags)} alt="" />
    )}
  </div>
  <div class="prj-body">
    <div class="prj-td">
      <div class="prj-name-row">
        <p class="prj-name">{project.title}</p>
        <svg class="prj-ext-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M11.3333 14H3.33333V12.6667H11.3333V14ZM3.33333 12.6667H2V4.66667H3.33333V12.6667ZM12.6667 12.6667H11.3333V8.66667H12.6667V12.6667ZM7.33333 10H6V8.66667H7.33333V10ZM8.66667 8.66667H7.33333V7.33333H8.66667V8.66667ZM10 7.33333H8.66667V6H10V7.33333ZM14 7.33333H12.6667V4.66667H11.3333V3.33333H8.66667V2H14V7.33333ZM11.3333 6H10V4.66667H11.3333V6ZM7.33333 4.66667H3.33333V3.33333H7.33333V4.66667Z" /></svg>
      </div>
      <p class="prj-desc">{project.description}</p>
      <p class="prj-author">{project.author}</p>
    </div>
    <div class="prj-tags">
      {project.tags.map((tag) => (
        <span class="prj-tag">{tag}</span>
      ))}
    </div>
  </div>
</a>
