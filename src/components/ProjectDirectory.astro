---
import type { Project } from "../data/projects";

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
const columns = [projects.slice(0, 5), projects.slice(5)];
---

<section class="prj" id="proyectos">
  <div class="prj-inner">
    <div class="prj-head">
      <h2 class="prj-title">Proyectos</h2>
      <div class="prj-nav">
        <button class="prj-arrow" type="button" aria-label="Anterior">
          <svg viewBox="0 0 48 48" fill="currentColor" aria-hidden="true"><path d="M16 26V22H20V26H16ZM20 22V18H24V22H20ZM20 30V26H24V30H20ZM24 18V14H28V18H24ZM24 34V30H28V34H24ZM28 14V10H32V14H28ZM28 38V34H32V38H28Z" /></svg>
        </button>
        <button class="prj-arrow" type="button" aria-label="Siguiente">
          <svg viewBox="0 0 48 48" fill="currentColor" aria-hidden="true"><path d="M32 26V22H28V26H32ZM28 22V18H24V22H28ZM28 30V26H24V30H28ZM24 18V14H20V18H24ZM24 34V30H20V34H24ZM20 14V10H16V14H20ZM20 38V34H16V38H20Z" /></svg>
        </button>
      </div>
    </div>
    <div class="prj-list">
      {columns.map((column) => (
        <div class="prj-col">
          {column.map((project) => (
            <a class="prj-item" href={project.href}>
              <div class="prj-thumb" aria-hidden="true"></div>
              <div class="prj-body">
                <div class="prj-td">
                  <p class="prj-name">{project.title}</p>
                  <p class="prj-desc">{project.description}</p>
                  <p class="prj-author">{project.author}</p>
                </div>
                <div class="prj-tags">
                  {project.tags.map((tag) => (
                    <span class="prj-tag">{tag}</span>
                  ))}
                </div>
              </div>
            </a>
          ))}
        </div>
      ))}
    </div>
    <div class="prj-cta-row">
      <p class="prj-cta-text">¿Eres parte de la comunidad y quieres sumarte al directorio?</p>
      <a class="prj-cta" href="#unete">AGREGA TU PROYECTO</a>
    </div>
  </div>
</section>